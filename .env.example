# Copy this file to .env and fill in your values
# cp .env.example .env

# Neo4j credentials
NEO4J_USER=neo4j
NEO4J_PASSWORD=your_password_here

# Neo4j connection URI
# Use "bolt://neo4j:7687" when running inside Docker
# Use "bolt://localhost:7687" when running Python locally
NEO4J_URI=bolt://neo4j:7687

# Dashboard port
DASH_PORT=8050